
{% extends 'base/base.html.twig' %}
{% block title %}Mes jurys{% endblock %}
{% block body %}
<h2 class="mb-3">Mes jurys</h2>
<table class="table table-hover bg-white shadow-sm">
    <thead class="table-light"><tr><th>Date</th><th>Heure</th><th>Étudiant</th><th>Mon rôle</th><th>Salle</th></tr></thead>
    <tbody>
    {% for s in soutenances %}
        <tr>
            <td>{{ s.date|date('d/m/Y') }}</td>
            <td>{{ s.heure|date('H:i') }}</td>
            <td>{{ s.etudiant }}</td>
            <td>
                {% if s.president == enseignant %}<span class="badge bg-primary">Président</span>{% endif %}
                {% if s.rapporteur == enseignant %}<span class="badge bg-info text-dark">Rapporteur</span>{% endif %}
                {% if s.examinateur == enseignant %}<span class="badge bg-secondary">Examinateur</span>{% endif %}
            </td>
            <td>{{ s.salle }}</td>
        </tr>
    {% else %}
        <tr><td colspan="5" class="text-center text-muted">Aucun jury</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
