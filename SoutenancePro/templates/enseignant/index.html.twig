
{% extends 'base/base.html.twig' %}
{% block title %}Enseignants{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Enseignants</h2>
    <a href="{{ path('app_enseignant_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvel enseignant</a>
</div>
<table class="table table-hover bg-white shadow-sm">
    <thead class="table-light"><tr><th>Nom</th><th>Prénom</th><th>Email</th><th>Spécialité</th><th>Compte</th><th></th></tr></thead>
    <tbody>
    {% for e in enseignants %}
        <tr>
            <td>{{ e.nom }}</td><td>{{ e.prenom }}</td><td>{{ e.email }}</td><td>{{ e.specialite }}</td>
            <td>{% if e.user %}<span class="badge bg-success">Oui</span>{% else %}<span class="badge bg-secondary">Non</span>{% endif %}</td>
            <td class="text-end text-nowrap">
                <a href="{{ path('app_enseignant_edit', {id: e.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                <form method="post" action="{{ path('app_enseignant_delete', {id: e.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ e.id) }}">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="6" class="text-center text-muted">Aucun enseignant</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
