<!DOCTYPE html>
<html lang="fr">
{% form_theme form 'bootstrap_5_layout.html.twig' %}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SoutenancePro{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background: #f4f6f9; }
        .navbar { background: #1F4E79 !important; }
        .card-stat { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
        .card-stat .icon { font-size: 2.2rem; opacity: .8; }
        .sidebar-link { color: #333; text-decoration: none; padding: .5rem 1rem; display: block; border-radius: 6px; }
        .sidebar-link:hover, .sidebar-link.active { background: #e8f0fe; color: #1F4E79; }
    </style>
</head>
<body>
<nav class="navbar navbar-dark navbar-expand-lg mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
            <i class="bi bi-mortarboard-fill"></i> SoutenancePro
        </a>
        {% if app.user %}
        <div class="d-flex align-items-center text-white">
            <span class="me-3"><i class="bi bi-person-circle"></i> {{ app.user.prenom }} {{ app.user.nom }}</span>
            <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">Déconnexion</a>
        </div>
        {% endif %}
    </div>
</nav>

<div class="container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'success' ? 'success' : 'info') }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        {% if app.user %}
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-2">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_dashboard_admin') }}" class="sidebar-link {{ app.request.attributes.get('_route') == 'app_dashboard_admin' ? 'active' : '' }}">
                            <i class="bi bi-speedometer2"></i> Tableau de bord
                        </a>
                        <a href="{{ path('app_etudiant_index') }}" class="sidebar-link {{ 'etudiant' in app.request.attributes.get('_route') ? 'active' : '' }}">
                            <i class="bi bi-people"></i> Étudiants
                        </a>
                        <a href="{{ path('app_enseignant_index') }}" class="sidebar-link {{ 'enseignant' in app.request.attributes.get('_route') ? 'active' : '' }}">
                            <i class="bi bi-person-badge"></i> Enseignants
                        </a>
                        <a href="{{ path('app_salle_index') }}" class="sidebar-link {{ 'salle' in app.request.attributes.get('_route') ? 'active' : '' }}">
                            <i class="bi bi-building"></i> Salles
                        </a>
                        <a href="{{ path('app_soutenance_index') }}" class="sidebar-link {{ 'soutenance' in app.request.attributes.get('_route') ? 'active' : '' }}">
                            <i class="bi bi-calendar-event"></i> Soutenances
                        </a>
                    {% else %}
                        <a href="{{ path('app_dashboard_enseignant') }}" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i> Tableau de bord
                        </a>
                        <a href="{{ path('app_enseignant_soutenances') }}" class="sidebar-link">
                            <i class="bi bi-calendar-check"></i> Mes soutenances
                        </a>
                        <a href="{{ path('app_enseignant_jurys') }}" class="sidebar-link">
                            <i class="bi bi-people"></i> Mes jurys
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-md-9">
        {% else %}
        <div class="col-12">
        {% endif %}

            {% block body %}{% endblock %}
        </div>
    </div>
</div>

<footer class="text-center text-muted py-4 mt-5 border-top bg-white">
    <small>
        &copy; {{ "now"|date("Y") }} SoutenancePro – Roméo ATOKOU<br>
        Examen Final IT232 – 2025/2026
    </small>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>